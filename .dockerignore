# =============================================================================
# Docker Ignore File - Synapse'26
# Excludes unnecessary files from Docker build context
# =============================================================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output
.next
out

# Testing
coverage
.nyc_output

# IDE and editor files
.idea
.vscode
*.swp
*.swo
.DS_Store

# Git
.git
.gitignore

# Environment files (should be injected at runtime)
.env
.env.*
!.env.example

# Docker files (prevent recursive copy)
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation
README.md
CHANGELOG.md
LICENSE
docs

# CI/CD
.github
.gitlab-ci.yml
.circleci

# Vercel
.vercel
.vercelignore

# Misc
*.log
*.md
!README.md
.husky
.eslintcache
tsconfig.tsbuildinfo
